# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# WhatsApp Business Platform (Meta app dashboard)
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Public URL of this deployment (used in emails and payment callbacks)
SITE_URL=https://app.example.com
PLATFORM_NAME=WhatsApp AI

# Email (verification, password reset, handoff alerts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Payments (Paystack). Webhook URL: https://<domain>/webhooks/paystack/
PAYSTACK_SECRET_KEY=
TRIAL_DAYS=14

# Voice-note transcription: none | whisper_http (any OpenAI-compatible /audio/transcriptions endpoint)
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# LLM
CHATBOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CHATBOT_DEFAULT_MODEL=claude-opus-5

# Embeddings: "hashing" (local, no key) or "voyage"
KNOWLEDGE_EMBEDDING_PROVIDER=hashing
VOYAGE_API_KEY=

# For local development without Docker
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_ai_saas
# REDIS_URL=redis://localhost:6379/0
